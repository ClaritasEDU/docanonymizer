# Doc Anonymizer environment config. Copy to `.env` to override.

DEFAULT_ENDPOINT_URL=http://localhost:11434
DEFAULT_ENDPOINT_STYLE=ollama
DEFAULT_MODEL=llama3.2
MAX_UPLOAD_MB=50
CHUNK_TOKENS=2000
CHUNK_OVERLAP_TOKENS=200
PORT=5000
# Seconds a local model may go silent mid-answer before a chunk is retried.
# Slow machines are fine as long as the model keeps producing output.
LLM_STALL_TIMEOUT_S=180
# Ollama context window per request (prompt + answer). Too small and Ollama
# silently drops the start of the prompt.
OLLAMA_NUM_CTX=8192
LOG_LEVEL=INFO
GITHUB_API_URL=https://api.github.com
